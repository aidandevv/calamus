# Calamus defaults. Parsed as data: only CALAMUS_[A-Z0-9_]+=value lines are read.
# Override in the environment, <project>/.calamus/calamus.env, or
# ${XDG_CONFIG_HOME:-~/.config}/calamus/calamus.env. Every model pin lives here.

CALAMUS_BACKEND=auto
CALAMUS_LLM_CMD=
CALAMUS_CLAUDE_MODEL=claude-haiku-4-5
CALAMUS_CODEX_MODEL=gpt-5.4-mini
CALAMUS_CURSOR_MODEL=
CALAMUS_CODEX_BIN=
CALAMUS_CURSOR_BIN=
CALAMUS_EVAL_BACKEND=claude
CALAMUS_LEVEL1_GATE=sampled
CALAMUS_LEVEL1_SAMPLE=4
CALAMUS_BACKEND_TIMEOUT=25
CALAMUS_TAIL_SWEEP=28000
CALAMUS_TAIL_SNAPSHOT=20000
CALAMUS_RAW_WINDOW=262144
CALAMUS_EXTRACT=on
CALAMUS_MIN_BYTES_SWEEP=800
CALAMUS_MIN_BYTES_SNAPSHOT=500
CALAMUS_MIN_TEXT=8000
CALAMUS_DEDUPE_SECS=30
CALAMUS_SESSION_END_MODE=auto
CALAMUS_FORMAT=md

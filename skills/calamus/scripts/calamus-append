#!/usr/bin/env python3
"""Validate, render, and append journal records read from stdin.

Usage: calamus-append --journal engineering|product [--root DIR] < entry.json

Input is one JSON object, a list, or {"entries": [...]}. Entries need
variant, tag, date, title, and the variant's fields; journal and id are
filled in. Markers use {"record": "marker", "kind": ...}. Prints "ok <id>"
per entry, or the field errors and exit 1.
"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))
import cli  # noqa: E402
import journal  # noqa: E402


def main():
    ap = argparse.ArgumentParser(description="Append validated Calamus records.")
    ap.add_argument("--journal", required=True, choices=["engineering", "product"])
    ap.add_argument("--root")
    args = ap.parse_args()
    raw = sys.stdin.read()
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as e:
        cli.die("input is not valid JSON: %s" % e)
    if isinstance(data, dict) and "entries" in data:
        data = data["entries"]
    recs = data if isinstance(data, list) else [data]
    if not recs:
        cli.die("no records in input")
    try:
        ids = journal.append_records(cli.project_root(args.root), args.journal, recs,
                                     fmt_env=os.environ.get("CALAMUS_FORMAT"))
    except journal.ValidationError as e:
        cli.die("invalid input, nothing written:\n" + "\n".join("  " + x for x in e.errors))
    except journal.DuplicateError as e:
        cli.die("duplicate, nothing written: %s" % e)
    for rid in ids:
        print("ok %s" % rid)
    if not ids:
        print("ok")


if __name__ == "__main__":
    main()
